# Notesown - Variables de entorno
# Copia este archivo a .env y rellena con tus credenciales de Supabase
# NO hagas commit de .env al repositorio

# Supabase (https://supabase.com/dashboard/project/<tu-proyecto>/settings/api)
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=<tu-anon-key>

# Después de obtener las credenciales, actualiza:
# src/environments/environment.ts         (desarrollo)
# src/environments/environment.prod.ts    (producción / Vercel)
# En Vercel: Settings > Environment Variables
